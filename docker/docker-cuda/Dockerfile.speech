# Speech-focused CUDA image for Qwen3-ASR, Qwen3.5 speech endpointing, and FunAudioChat SFT.
# It extends the standard CUDA image with audio system packages and Python speech helpers.
ARG BASE_IMAGE=hiyouga/pytorch:th2.6.0-cu124-flashattn2.7.4-cxx11abi0-devel
FROM ${BASE_IMAGE}

ARG PIP_INDEX=https://pypi.org/simple
ARG INSTALL_FLASHATTN=false
ARG FLASH_ATTN_VERSION=2.8.3
ARG UBUNTU_MIRROR=https://mirrors.ustc.edu.cn/ubuntu/
ARG HTTP_PROXY=""

ENV MAX_JOBS=16
ENV FLASH_ATTENTION_FORCE_BUILD=TRUE
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_OPTIONS=""
ENV PIP_ROOT_USER_ACTION=ignore
ENV PYTHONUNBUFFERED=1
ENV TORCH_EXTENSIONS_DIR=/root/.cache/torch_extensions
ENV HF_HOME=/root/.cache/huggingface
ENV HF_HUB_CACHE=/root/.cache/huggingface/hub
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface/hub
ENV HF_HUB_ENABLE_HF_TRANSFER=1
ENV http_proxy="${HTTP_PROXY}"
ENV https_proxy="${HTTP_PROXY}"

SHELL ["/bin/bash", "-c"]
WORKDIR /app

RUN cat > /etc/apt/sources.list <<EOF
deb ${UBUNTU_MIRROR} jammy main restricted universe multiverse
deb ${UBUNTU_MIRROR} jammy-updates main restricted universe multiverse
deb ${UBUNTU_MIRROR} jammy-backports main restricted universe multiverse
deb ${UBUNTU_MIRROR} jammy-security main restricted universe multiverse
EOF

RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y --no-install-recommends ffmpeg git git-lfs libsndfile1 && \
    git lfs install --system && \
    rm -rf /var/lib/apt/lists/*

RUN pip config set global.index-url "${PIP_INDEX}" && \
    pip config set global.extra-index-url "${PIP_INDEX}" && \
    pip install --no-cache-dir --upgrade pip packaging wheel setuptools editables "hatchling>=1.18.0"

COPY . /app

RUN pip install --no-cache-dir --no-build-isolation -e . && \
    pip install --no-cache-dir --no-build-isolation \
        -r requirements/metrics.txt \
        -r requirements/speech.txt

RUN if [ "${INSTALL_FLASHATTN}" == "true" ]; then \
        pip uninstall -y flash-attn ninja || true && \
        pip install --no-cache-dir ninja && \
        pip install --no-cache-dir --no-build-isolation "flash-attn==${FLASH_ATTN_VERSION}"; \
    fi

# VOLUME ["/root/.cache/huggingface", "/root/.cache/torch_extensions", "/app/output"]

ENV GRADIO_SERVER_PORT=7860
ENV API_PORT=8000
EXPOSE 7860
EXPOSE 8000

ENV http_proxy=
ENV https_proxy=

RUN pip config unset global.index-url && \
    pip config unset global.extra-index-url
